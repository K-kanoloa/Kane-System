[Unit]
Description=Kane System local Owner setup
After=local-fs.target systemd-user-sessions.service
Before=serial-getty@ttyS0.service
Conflicts=serial-getty@ttyS0.service
ConditionPathExists=!/etc/kane-system/owner-initialized.json
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/libexec/kane-system/console.py
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0
TTYReset=yes
TTYVHangup=yes
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
