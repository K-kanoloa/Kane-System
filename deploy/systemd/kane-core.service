[Unit]
Description=Kane System native object registry and private Owner control service
Documentation=file:/usr/share/doc/kane-system-core/SYSTEM-PROFILE.md
PartOf=kane-system.target
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=kane-system
Group=kane-system
ExecStart=/usr/bin/kanesys --config /etc/kane-system/core.env serve
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
StateDirectory=kane-system
StateDirectoryMode=0700
RuntimeDirectory=kane-system
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=kane-system.target
