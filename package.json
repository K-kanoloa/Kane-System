{
    "name": "kane-system",
    "private": true,
    "license": "PolyForm-Noncommercial-1.0.0",
    "version": "0.3.0-dev",
    "description": "Kane System: Linux AI-native system development based on Kane-Kanaloa.",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "setup:dsh": "node scripts/patch-dsh-acp.mjs",
        "setup:api": "node scripts/setup-python.mjs apps/api",
        "setup:bridge": "node scripts/setup-python.mjs apps/local-bridge",
        "setup:kanaloa-tools": "npm --workspace @kane/kanaloa-tools run setup",
        "test:kanaloa-tools": "npm --workspace @kane/kanaloa-tools test",
        "setup": "npm run setup:dsh && npm run setup:api && npm run setup:bridge",
        "postinstall": "node scripts/patch-dsh-acp.mjs",
        "venv:api": "npm run setup:api",
        "venv:bridge": "npm run setup:bridge",
        "dev": "node scripts/dev-stack.mjs",
        "dev:stack": "node scripts/dev-stack.mjs",
        "start:stack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-stack.ps1",
        "stop:stack": "powershell -ExecutionPolicy Bypass -File scripts/stop-stack.ps1",
        "wait:stack": "powershell -ExecutionPolicy Bypass -File scripts/wait-for-stack.ps1",
        "test:e2e:smoke": "node scripts/e2e-smoke.mjs",
        "test:e2e:ui": "node scripts/e2e-ui.mjs",
        "dev:api": "node scripts/run-python.mjs apps/api -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
        "dev:bridge": "node scripts/run-python.mjs apps/local-bridge -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8010",
        "dev:web": "npm --workspace @kane/web run dev",
        "verify": "npm run typecheck:web && npm run build:web && npm run test:api && npm run test:bridge",
        "typecheck": "npm --workspace @kane/web run typecheck",
        "typecheck:web": "npm --workspace @kane/web run typecheck",
        "build:web": "npm --workspace @kane/web run build",
        "lint": "npm --workspace @kane/web run lint",
        "test:api": "node scripts/run-python.mjs apps/api -m pytest -q",
        "test:bridge": "node scripts/run-python.mjs apps/local-bridge -m pytest -q",
        "test:system:core": "cargo test --workspace --locked",
        "test:system:ui": "node scripts/e2e-system.mjs"
    },
    "dependencies": {
        "@deepseek-ai/dsh": "0.1.5-rc.3",
        "@deepseek-ai/dsh-acp": "0.1.5-rc.3",
        "undici": "8.11.2"
    },
    "devDependencies": {
        "playwright": "^1.59.1"
    }
}
